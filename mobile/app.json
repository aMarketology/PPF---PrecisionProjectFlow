{
  "expo": {
    "name": "Precision Project Flow",
    "scheme": "ppf",
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-image-picker", {
        "photosPermission": "Allow Precision Project Flow to attach receipt photos for your company back office.",
        "cameraPermission": "Allow Precision Project Flow to capture receipt photos for your company back office."
      }]
    ],
    "experiments": { "typedRoutes": true },
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
